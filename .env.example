DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Used by the container. Local runserver can leave these unset.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DB_PATH=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://budget.example.com
# DJANGO_SITE_DOMAIN=localhost:8000
# DJANGO_ACCOUNT_PROTOCOL=http
# DJANGO_BEHIND_PROXY=0

# Optional. When both values for a provider are set, `migrate` turns the
# button on at http://localhost:8000/accounts/login/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
